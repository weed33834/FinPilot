# FinPilot AI — 环境变量样例
# 用法：cp .env.example .env 后按需修改；docker compose up 会自动加载 .env

# ─── 数据库（PostgreSQL）───
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot_dev_pwd
POSTGRES_DB=finpilot

# ─── Redis ───
# docker compose 内部用 REDIS_URL=redis://redis:6379/0，本地开发可保持默认
# REDIS_URL=redis://localhost:6379/0

# ─── LLM ───
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=DeepSeek-V4-Pro

# ─── 默认管理员 ───
# 不设置 FINPILOT_ADMIN_PASSWORD 则不创建默认管理员（更安全，需手动注册/创建）
FINPILOT_ADMIN_EMAIL=admin@finpilot.ai
FINPILOT_ADMIN_PASSWORD=

# ─── 会话加密密钥 ───
# 生产必须设置，至少 32 字节随机串。生成命令：python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=

# ─── 运行环境 ───
ENVIRONMENT=production
